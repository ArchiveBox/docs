    {
      "id": "7409d6ec-8532-4442-bb51-018a23009441",
      "name": "Read title and output_size",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        480,
        320
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "url": "=https://api.archivebox.example/api/v1/core/snapshot/{{ $json.body.pk }}"
      }
    },
    {
      "id": "be481dd6-27d0-4ff8-a8ce-5c813873f0a3",
      "name": "Prepare sheet columns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        320
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const snapshot = item.json;\n  const screenshot = snapshot.archiveresults.some(result => result.plugin === 'screenshot' &&\n    Object.keys(result.output_files || {}).some(path => path.endsWith('screenshot.png')));\n  const detail = \"https://web.archivebox.example\" + '/' + snapshot.archive_path;\n  const imageUrl = \"https://web.archivebox.example\" + '/' + snapshot.archive_path + '/screenshot/screenshot.png';\n  return {json: {URL: snapshot.url, Title: snapshot.title || '', Snapshot: detail,\n    Screenshot: screenshot ? '=IMAGE(\"' + imageUrl + '\",1)' : '',\n    output_size: snapshot.output_size, Status: screenshot ? 'Archived' : 'No screenshot'}};\n});"
      }
    },
    {
      "id": "818c91fe-fd94-488e-849b-7fd5104abd6d",
